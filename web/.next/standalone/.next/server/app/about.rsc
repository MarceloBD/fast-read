5:["$","section",null,{"children":[["$","h2",null,{"children":"How to use Fast Read?"}],["$","ol",null,{"children":[["$","li",null,{"children":"Paste text or drag and drop a document file"}],["$","li",null,{"children":"Click the Play button to start speed reading"}],["$","li",null,{"children":"Adjust speed with Up/Down arrow keys or the slider"}],["$","li",null,{"children":"Use Left/Right arrows to navigate words"}],["$","li",null,{"children":"Press M to toggle between Study and Speed modes"}]]}]]}]
6:["$","section",null,{"children":[["$","h2",null,{"children":"Frequently Asked Questions"}],["$","h3",null,{"children":"How fast can I read with RSVP?"}],["$","p",null,{"children":"Most users start at 300 WPM and can increase to 500-800 WPM with practice. Advanced users may reach 1000+ WPM for familiar material."}],["$","h3",null,{"children":"Does speed reading reduce comprehension?"}],["$","p",null,{"children":"At moderate speeds (300-500 WPM), comprehension remains high. Above 600 WPM, comprehension may decrease for complex material. Use Study mode for technical content."}],["$","h3",null,{"children":"Is my data private?"}],["$","p",null,{"children":"Yes. All document processing happens entirely in your browser. No files are uploaded to any server. Your reading preferences are stored locally."}],["$","h3",null,{"children":"Can I use it on mobile?"}],["$","p",null,{"children":"Yes. The web version works on any modern browser. A desktop version built with Tauri is also available for Windows, macOS, and Linux."}]]}]
